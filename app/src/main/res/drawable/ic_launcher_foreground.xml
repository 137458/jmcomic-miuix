<?xml version="1.0" encoding="utf-8"?>
<!-- 前景层：J3 字标（应用名 jm3 的首字母 + 序号），纯白单色，不掺第二种颜色。
     字形按标志处理：统一 7dp 字重、所有收笔都与笔画垂直并平切，J 的钩尾上挑、3 的腰点收在中线左侧；
     J 与 3 之间留约 9dp 断笔，24dp 下仍是两块独立字形，不粘连。
     几何全部落在自适应图标安全圆内（108dp 画布以 54,54 为圆心、半径 33dp），
     实测最外点为 J 竖笔顶角与钩尾（距圆心 31.7dp）、3 的右侧碗沿（27.7dp），任何遮罩都不裁切。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- J：长竖笔 + 深钩，钩尾平切后微微上挑 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round"
        android:pathData="M38,32.5 L38,60.5 C38,67 35.5,71.5 30,70.5" />

    <!-- 3：短顶横 + 上下两个右凸碗，腰点收在 57.5 形成明确的字腔开口方向 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round"
        android:pathData="M54,32.5 H65 C71.5,32.5 76,37 76,43.5 C76,48.5 67,53.5 57.5,54.5 C67,55.5 76,59.5 76,65 C76,70.5 70.5,74 62,74" />
</vector>

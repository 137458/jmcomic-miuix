        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="6"
                android:endX="96"
                android:endY="104">
                <item
                    android:offset="0"
                    android:color="#FF0A2A5E" />
                <item
                    android:offset="1"
                    android:color="#FF1B4E9E" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="26"
                android:gradientRadius="76">
                <item
                    android:offset="0"
                    android:color="#389EC2FF" />
                <item
                    android:offset="1"
                    android:color="#009EC2FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

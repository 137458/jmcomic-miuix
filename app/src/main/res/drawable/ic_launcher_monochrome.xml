<?xml version="1.0" encoding="utf-8"?>
<!-- 单色层：与前景同一副字标，去掉所有细节只留一块实色剪影。
     Android 13+ 主题图标只用这一层的 alpha 当遮罩、由系统重新染色，
     所以这里必须是满不透明的整块形状，轮廓才不会在深色壁纸下丢失。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:pathData="M45,30 L55,30 L55,60 C55,66 59,69 64,67.5 L66.5,74 C57,77.5 45,73.5 45,62 Z" />
</vector>
